# =============================================================================
# Variables d'environnement — Gesta School API
#
# Copiez ce fichier en `.env` et renseignez les valeurs de votre installation.
# `.env` est ignoré par git : il ne doit jamais être versionné.
# =============================================================================

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=gesta_school

# --- Schéma de base de données ---
# Le schéma évolue par migrations : `npm run migration:run` avant la mise en
# service. Ces deux options restent à false en usage normal.
#
# DB_SYNCHRONIZE aligne le schéma sur les entités à chaque démarrage et
# SUPPRIME sans prévenir toute colonne ou table qu'il ne reconnaît pas.
# Réservé à un prototypage sur base jetable.
DB_SYNCHRONIZE=false
# Exécute les migrations en attente au démarrage plutôt que par le CLI.
DB_MIGRATIONS_RUN=false

# --- Serveur ---
PORT=3001
# Passez à "production" en déploiement : cela conditionne notamment le refus
# de créer un super-administrateur sans mot de passe explicite.
NODE_ENV=development

# --- Sécurité ---
# Secret de signature des jetons JWT. Obligatoire, 32 caractères minimum :
# l'API refuse de démarrer s'il est absent, vide ou trop court.
# Générez-en un avec :  openssl rand -base64 48
JWT_SECRET=

# Origines autorisées à appeler l'API, séparées par des virgules.
# C'est l'adresse de l'interface web, pas celle de l'API.
#
# OBLIGATOIRE en production : l'API refuse de démarrer sans, plutôt que de
# s'ouvrir à tous les sites. Vide hors production = tout autorisé.
#
# La session reposant sur un cookie, cette liste est aussi ce qui autorise le
# navigateur à l'émettre : une origine absente d'ici sera déconnectée en
# permanence, sans message d'erreur explicite.
#
#   CORS_ORIGINS=https://ecole.exemple.ci,https://www.ecole.exemple.ci
CORS_ORIGINS=

# À passer à "true" uniquement si l'API tourne derrière un reverse proxy
# (nginx, Caddy, Traefik). Sans cela, la limitation des tentatives de connexion
# voit l'adresse du proxy au lieu de celle du poste, et compte tout le trafic
# sur une seule adresse. À laisser "false" si l'API est exposée directement :
# un client pourrait sinon usurper son adresse via un en-tête X-Forwarded-For.
TRUST_PROXY=false

# La session est portée par un cookie httpOnly, marqué `Secure` dès que
# NODE_ENV=production : servez alors l'API en HTTPS, faute de quoi le navigateur
# n'émettra jamais le cookie et personne ne pourra se connecter.
#
# Interface et API doivent partager le même domaine enregistrable — un port ou
# un sous-domaine différent convient (ecole.ci et api.ecole.ci). Sur deux
# domaines distincts, il faudrait passer le cookie en SameSite=None et ajouter
# une protection anti-CSRF.

# --- Compte super-administrateur ---
# Utilisés UNIQUEMENT au tout premier démarrage, lorsqu'aucun compte
# super-administrateur n'existe encore. Ils n'écrasent jamais un compte
# existant : pour changer le mot de passe ensuite, passez par l'application.
#
# Sans SUPER_ADMIN_PASSWORD :
#   - hors production, un mot de passe aléatoire est généré et affiché une
#     seule fois dans les logs, à la création ;
#   - en production, aucun compte n'est créé et une erreur est journalisée.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=Gesta@2026